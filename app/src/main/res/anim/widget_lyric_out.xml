<?xml version="1.0" encoding="utf-8"?>
<!-- Mirror of the incoming fade: same duration and interpolator, reversed alpha. Matching curves keep
     the alphas complementary. The smaller drift stops a fast line change from looking like a jump. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <alpha
        android:duration="260"
        android:fromAlpha="1.0"
        android:interpolator="@android:interpolator/accelerate_decelerate"
        android:toAlpha="0.0" />
    <translate
        android:duration="260"
        android:fromYDelta="0%"
        android:interpolator="@android:interpolator/accelerate_decelerate"
        android:toYDelta="-16%" />
</set>
