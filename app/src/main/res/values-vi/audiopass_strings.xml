    <string name="audiopass_resampler_desc">Chỉ dành cho loa và giắc cắm tai nghe. Bài hát được đưa về tần số riêng của điện thoại bằng bộ lọc sạch hơn của Android.</string>
    <string name="audiopass_passthrough">Truyền bit-perfect</string>
    <string name="audiopass_passthrough_desc">Bài hát đến DAC nguyên vẹn, không qua trộn hay lấy mẫu lại của Android.</string>
    <string name="audiopass_modes">Chế độ</string>
    <string name="audiopass_mode_song_rate">Theo tần số bài hát</string>
    <string name="audiopass_mode_song_rate_desc">Android chạy DAC theo đúng tần số của từng bài hát. Hiệu ứng vẫn hoạt động.</string>
    <string name="audiopass_mode_bit_perfect">Bit-perfect</string>
    <string name="audiopass_mode_bit_perfect_desc">Android chuyển mọi bài hát lossless đến DAC mà không chỉnh sửa.</string>
    <string name="audiopass_mode_direct_usb">USB trực tiếp</string>
    <string name="audiopass_mode_direct_usb_desc">Mochy tự điều khiển DAC trên mọi phiên bản Android và chỉnh âm lượng ngay trên DAC. Cần quyền truy cập USB.</string>
    <string name="audiopass_mode_exclusive_usb">USB độc quyền</string>
    <string name="audiopass_mode_exclusive_usb_desc">DAC chỉ mở riêng cho Mochy ở đúng tần số của bài hát. Không phải điện thoại nào cũng cho phép.</string>
    <string name="audiopass_mode_exclusive_dac">DAC tích hợp</string>
    <string name="audiopass_mode_exclusive_dac_desc">Dành cho máy nghe nhạc có DAC riêng: giắc cắm tai nghe chỉ mở riêng cho Mochy.</string>
