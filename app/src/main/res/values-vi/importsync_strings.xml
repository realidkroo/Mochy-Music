    <!-- TuneMyMusic Import Screen -->
    <string name="tunemymusic_info_intro">Hoạt động với bất kỳ dịch vụ nào mà TuneMyMusic hỗ trợ, bao gồm cả danh sách phát riêng tư và bài hát đã thích.</string>
    <string name="tunemymusic_step_1">Mở TuneMyMusic và chọn dịch vụ nguồn bạn đang dùng (Spotify, Apple Music, Tidal, Amazon Music…).</string>
    <string name="tunemymusic_step_2">Đăng nhập tại đó và chọn các danh sách phát cùng bài hát đã thích cần chuyển.</string>
    <string name="tunemymusic_step_3">Tại phần đích đến, chọn \"Export to file\", sau đó chọn CSV.</string>
    <string name="tunemymusic_step_4">Quay lại đây và chọn tệp .csv vừa tải về.</string>
    <string name="tunemymusic_open_site">Mở TuneMyMusic</string>
    <string name="tunemymusic_open_site_desc">tunemymusic.com trong trình duyệt của bạn</string>
    <string name="tunemymusic_no_browser">Không tìm thấy trình duyệt</string>
