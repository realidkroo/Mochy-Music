    <string name="playback_keep_playing">Keep playing even when closed</string>
    <string name="playback_keep_playing_desc">Keep playing after the app is cleared</string>
    <string name="playback_keep_playing_detail">Continue playback in background when app is cleared from recents</string>
    <string name="playback_mix_other_apps">Play alongside other apps</string>
    <string name="playback_mix_other_apps_desc">Keep playing when another app makes sound</string>
    <string name="playback_mix_other_apps_detail">Mochy won\'t pause when a video, game or another music app starts playing, and it won\'t pause them either. Phone calls still pause the music, and it picks back up when the call ends.</string>
    <string name="playback_save_state">Save Player\'s last state</string>
